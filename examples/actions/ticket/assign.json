{
  "format_version": "2",
  "action": "support.assign",
  "version": "1",
  "tool": "assign_tickets",
  "fields": {
    "tickets": {
      "type": "array",
      "least": "1",
      "most": "4",
      "items": {
        "type": "object",
        "fields": {
          "id": {
            "type": "string",
            "min": "5",
            "max": "24",
            "pattern": "INC-*"
          },
          "team": {
            "type": "string",
            "min": "1",
            "max": "24",
            "pattern": "team-*"
          },
          "hours": {
            "type": "number",
            "min": 0,
            "max": 80
          },
          "priority": {
            "type": "enum",
            "values": [
              "low",
              "normal",
              "high"
            ]
          },
          "notify": {
            "type": "boolean"
          },
          "copies": {
            "type": "integer",
            "min": 1,
            "max": 3
          }
        }
      }
    }
  }
}
