{
  "refs": {
    "policy": {
      "id": "release-policy",
      "version": "1"
    },
    "catalog": {
      "id": "release-catalog",
      "version": "1"
    },
    "registry": {
      "id": "iil-capabilities",
      "version": "0.1"
    }
  },
  "capabilities": {
    "github.file.read": {
      "supported": true,
      "resource_type": "github.file",
      "effect": "Request the content of one existing regular file at the bound revision."
    },
    "github.file.update": {
      "supported": true,
      "resource_type": "github.file",
      "effect": "Request replacement of one existing regular file conditional on its base revision."
    },
    "github.file.delete": {
      "supported": true,
      "resource_type": "github.file",
      "effect": "Request deletion of one existing regular file conditional on its base revision."
    },
    "github.pull_request.create": {
      "supported": false,
      "resource_type": "github.pull_request",
      "effect": "Request creation of a pull request. This operation is deferred in v0.1."
    }
  },
  "repositories": {
    "repo-demo": {
      "host": "github.example",
      "provider_id": "1001"
    }
  },
  "snapshots": [
    {
      "repository_id": "repo-demo",
      "branch": "main",
      "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "files": {
        "README.md": "regular",
        "docs/guide.md": "regular",
        "docs/obsolete.md": "regular",
        "docs-old/a.md": "regular",
        "src/auth.py": "regular",
        "guide-link": "symlink",
        "vendor/library": "submodule",
        "readme-alias": "alias"
      },
      "eligible": {
        "github.file.read": [
          "README.md",
          "docs/guide.md",
          "docs-old/a.md",
          "src/auth.py"
        ],
        "github.file.update": [
          "docs/guide.md",
          "src/auth.py"
        ],
        "github.file.delete": [
          "docs/obsolete.md",
          "src/auth.py"
        ]
      },
      "groups": {
        "authentication": {
          "members": [
            "src/auth.py"
          ],
          "complete": true,
          "review_ref": "auth-review"
        },
        "release-docs": {
          "review_ref": "guide-review",
          "complete": true,
          "members": [
            "docs/guide.md"
          ]
        }
      }
    }
  ],
  "evidence": {
    "auth-review": {
      "status": "reviewed",
      "source": "Synthetic authentication classification reviewed for the demo snapshot."
    },
    "model-note": {
      "status": "claimed",
      "source": "Synthetic unverified classification suggestion."
    },
    "guide-review": {
      "status": "reviewed",
      "source": "Synthetic release-team review of the guide at the recorded revision."
    }
  },
  "denials": [
    {
      "repository_id": "repo-demo",
      "capabilities": [
        "github.file.read",
        "github.file.update",
        "github.file.delete"
      ],
      "selector": {
        "kind": "catalog_group",
        "value": "authentication"
      }
    },
    {
      "repository_id": "repo-demo",
      "selector": {
        "value": "release-docs",
        "kind": "catalog_group"
      },
      "capabilities": [
        "github.file.update"
      ]
    }
  ]
}
